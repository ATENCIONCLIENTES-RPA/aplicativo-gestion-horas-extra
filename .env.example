# =============================================================================
# VARIABLES DE ENTORNO PÚBLICAS DEL FRONTEND
# =============================================================================
# Copia este archivo a .env y define los valores de tu proyecto Supabase:
#   cp .env.example .env
#
# NUNCA incluyas la clave 'service_role' ni secretos del servidor aquí.
# La clave VITE_SUPABASE_ANON_KEY es la clave pública (anon / publishable).
# =============================================================================

# URL de tu instancia de Supabase (ejemplo: https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://xxxx.supabase.co

# Clave pública de acceso cliente (anon / publishable key)
VITE_SUPABASE_ANON_KEY=su-clave-publica-anon-o-publishable

# Ruta base del aplicativo (./ para hosting estático relativo, GitHub Pages, etc.)
VITE_BASE_PATH=./
